@model WiseLine.Portal.Api.Models.OAuthAuthorizationViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connect @Model.ClientName — WiseLine Trade</title>
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #10251f; background: #f4f8f5; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; }
        main { width: min(100%, 620px); background: white; border: 1px solid #dce7e1; border-radius: 24px; padding: 36px; box-shadow: 0 24px 70px rgba(18, 59, 43, .12); }
        .brand { display: flex; gap: 12px; align-items: center; font-weight: 800; font-size: 20px; }
        .mark { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; color: white; background: #145c45; }
        h1 { margin: 30px 0 10px; font-size: clamp(30px, 5vw, 42px); letter-spacing: -.04em; }
        .intro { color: #5e746c; font-size: 17px; line-height: 1.55; }
        ul { list-style: none; padding: 0; margin: 28px 0; display: grid; gap: 12px; }
        li { padding: 16px; border: 1px solid #dce7e1; border-radius: 14px; }
        li strong { display: block; margin-bottom: 5px; }
        li span { color: #5e746c; line-height: 1.45; }
        .notice { padding: 14px 16px; background: #eff8f3; border-radius: 12px; color: #315c4d; font-size: 14px; line-height: 1.45; }
        form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 26px; }
        button { min-height: 50px; border-radius: 12px; border: 1px solid #bfd1c8; font: inherit; font-weight: 750; cursor: pointer; }
        .deny { background: white; color: #314c43; }
        .allow { background: #145c45; border-color: #145c45; color: white; }
        @@media (max-width: 520px) { main { padding: 24px; } form { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
<main>
    <div class="brand"><span class="mark">W</span> WiseLine Trade</div>
    <h1>Connect @Model.ClientName?</h1>
    <p class="intro">This AI client is requesting access to your WiseLine Investment MCP account.</p>
    <ul>
        @foreach (var scope in Model.Scopes)
        {
            <li><strong>@scope.Name</strong><span>@scope.Description</span></li>
        }
    </ul>
    <div class="notice">WiseLine never shares your password or payment details. You can revoke this connection later.</div>
    <form method="post">
        @Html.AntiForgeryToken()
        @foreach (var parameter in Model.RequestParameters)
        {
            <input type="hidden" name="@parameter.Name" value="@parameter.Value" />
        }
        <button class="deny" type="submit" name="decision" value="deny">Cancel</button>
        <button class="allow" type="submit" name="decision" value="allow">Allow connection</button>
    </form>
</main>
</body>
</html>
